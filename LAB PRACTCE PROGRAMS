2. Employee Salary Calculator
Python
basic_salary = float(input("Enter basic salary: "))
# Allowances
hra = 0.20 * basic_salary # House Rent Allowance (20%)
da = 0.10 * basic_salary # Dearness Allowance (10%)
gross_salary = basic_salary + hra + da
# Deductions
pf = 0.12 * basic_salary # Provident Fund (12%)
tax = 0.05 * gross_salary # Income Tax (5%)
total_deductions = pf + tax
net_salary = gross_salary - total_deductions
print(f"\nGross Salary: ${gross_salary:.2f}")
print(f"Total Deductions: ${total_deductions:.2f}")
print(f"Net Salary (Take-home): ${net_salary:.2f}")

